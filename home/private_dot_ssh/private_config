# Machine-local / work-specific hosts live in ~/.ssh/config.d/ (not tracked in
# the public dotfiles repo). Include must come before any Host/Match block.
Include config.d/*

#SSH Agent
AddKeysToAgent yes

# GITHUB
Host github.com
   HostName github.com
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/id_github_ed25519

# GITLAB
Host gitlab.com
   HostName gitlab.com
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/id_gitlab_ed25519

[user]
  name = Sven Gerber
  useConfigOnly = true

[commit]
  gpgsign = true

[pull]
  rebase = false

[gpg]
  format = ssh

[alias]
  st = status
  logg = log --graph --decorate --oneline --all
  cm = commit -s
  df = diff
  dfs = diff --staged


[includeIf "gitdir:~/github*/"]
  path = ~/.gitconfig.github

[includeIf "gitdir:~/gitlab/*"]
  path = ~/.gitconfig.gitlab

[includeIf "gitdir:~/gitlab*/"]
  path = ~/.gitconfig.gitlab

# Machine-local / work-specific identities (not tracked in the public dotfiles
# repo). Last, so its includeIf blocks override the ones above.
[include]
  path = ~/.gitconfig.local
